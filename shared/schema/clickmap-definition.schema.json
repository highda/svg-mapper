                {
                  "type": "string",
                  "pattern": "^(?:\\d+(?:\\.\\d+)?|\\.\\d+)(?:px|%|em|rem)$"
                }
              ]
            },
            "sheetBelow": {
              "type": "number",
              "minimum": 0
            },
            "label": {
              "type": "string"
            },
            "defaultContent": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string"
                },
                "body": {
                  "type": "string"
                }
              },
              "required": []
            },
            "hideWhenIdle": {
              "type": "boolean"
            }
          },
          "required": []
        },
        "padding": {
          "type": "object",
          "properties": {
            "top": {
              "type": "number",
              "minimum": 0
            },
            "right": {
              "type": "number",
              "minimum": 0
            },
            "bottom": {
              "type": "number",
              "minimum": 0
            },
            "left": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "top",
            "right",
            "bottom",
            "left"
          ]
        },
        "lang": {
          "type": "string"
        },
        "dir": {
          "enum": [
            "ltr",
            "rtl"
          ],
          "type": "string"
        },
        "strings": {
          "type": "object",
          "properties": {
            "directoryToggle": {
              "type": "string"
            },
            "directoryTitle": {
              "type": "string"
            },
            "directoryLabel": {
              "type": "string"
            },
            "directoryCloseLabel": {
              "type": "string"
            },
            "searchPlaceholder": {
              "type": "string"
            },
            "searchLabel": {
              "type": "string"
            },
            "filterLabel": {
              "type": "string"
            },
            "placeCount": {
              "type": "string"
            },
            "placeCountOne": {
              "type": "string"
            },
            "noResults": {
              "type": "string"
            },
            "result": {
              "type": "string"
            },
            "resultUnavailable": {
              "type": "string"
            },
            "revealAnnounce": {
              "type": "string"
            },
            "back": {
              "type": "string"
            },
            "backLabel": {
              "type": "string"
            },
            "breadcrumbLabel": {
              "type": "string"
            },
            "viewsLabel": {
              "type": "string"
            },
            "chooseView": {
              "type": "string"
            },
            "viewAnnounce": {
              "type": "string"
            },
            "mapLabel": {
              "type": "string"
            },
            "zoomIn": {
              "type": "string"
            },
            "zoomInLabel": {
              "type": "string"
            },
            "zoomOut": {
              "type": "string"
            },
            "zoomOutLabel": {
              "type": "string"
            },
            "zoomReset": {
              "type": "string"
            },
            "zoomResetLabel": {
              "type": "string"
            },
            "close": {
              "type": "string"
            },
            "closeLabel": {
              "type": "string"
            },
            "detailsLabel": {
              "type": "string"
            },
            "layerShown": {
              "type": "string"
            },
            "layerHidden": {
              "type": "string"
            },
            "layerError": {
              "type": "string"
            },
            "loading": {
              "type": "string"
            },
            "error": {
              "type": "string"
            }

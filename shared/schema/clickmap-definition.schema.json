{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "svg-mapper map definition (map.json)",
  "description": "ClickMapDefinition, the contract between the svg-mapper builder and renderer. This release writes schemaVersion 1.2.0 and reads any 1.x.y. A major version change is breaking; minor and patch changes are additive. See docs/data-model.md.",
  "$comment": "Generated from shared/schema.ts by shared/scripts/json-schema.mjs; do not edit by hand. Structural only: rules across objects (settings.initialViewId, goToView and toggleLayer targets and asset ids must exist; ids and view slugs must be unique; minZoom <= initialZoom <= maxZoom) are semantic checks made by validateProject, not by this schema. The runtime decoder additionally requires image.hitMask.data to hold exactly ceil(width * height / 8) base64-encoded bytes and data: URIs in assets[].src to be well formed. Objects accept extra properties.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "project": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "createdAt": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "createdAt",
        "updatedAt"
      ]
    },
    "settings": {
      "$ref": "#/$defs/Settings"
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Asset"
      }
    },
    "views": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/View"
      }
    },
    "popups": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "allowHtml": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "name"
        ]
      }
    },
    "sharedStyles": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "style": {
            "$ref": "#/$defs/AreaStyle"
          }
        },
        "required": [
          "name",
          "style"
        ]
      }
    },
    "customEvents": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schemaVersion",
    "project",
    "settings",
    "assets",
    "views",
    "popups",
    "sharedStyles",
    "customEvents"
  ],
  "$defs": {
    "Settings": {

        },
        "src": {
          "type": "string"
        },
        "width": {
          "type": "number",
          "minimum": 1
        },
        "height": {
          "type": "number",
          "minimum": 1
        },
        "inline": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "type",
        "name",
        "src",
        "width",
        "height",
        "inline"
      ]
    },
    "View": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {

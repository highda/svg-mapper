                "top-left",
                "top-center",
                "top-right",
                "bottom-left",
                "bottom-right",
                "middle-left",
                "middle-right"
              ],
              "type": "string"
            }
          },
          "required": [
            "type",
            "x",
            "y",
            "anchor"
          ]
        }
      ]

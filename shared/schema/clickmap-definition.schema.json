                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "minItems": 2
              }
            }
          },
          "required": [
            "type",
            "points"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "path"
            },
            "d": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "d"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "marker"

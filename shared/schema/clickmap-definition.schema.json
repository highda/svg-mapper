                "type": "object",
                "properties": {
                  "value": {
                    "type": "string"
                  },
                  "label": {
                    "type": "string"
                  }
                },
                "required": [
                  "value",
                  "label"
                ]
              }
            }
          },
          "required": [
            "enabled"
          ]
        },
        "details": {
          "type": "object",
          "properties": {
            "presentation": {
              "enum": [
                "popover",
                "panel",
                "modal"
              ],
